<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwExceptions="false"
      internalLogLevel="Off">

	<!-- https://github.com/nlog/nlog/wiki/Configuration-file -->
	<!-- This file is embedded into the add-in assembly and loaded by Commons/LogSetup.cs -->

	<variable name="logDir" value="${specialfolder:folder=LocalApplicationData}/Navferty/ExcelAddIn/logs" />

	<targets async="true">
		<target xsi:type="File" name="f" encoding="utf-8"
				fileName="${logDir}/${shortdate}.log"
				layout="${longdate}|${processid}|${threadid}|${uppercase:${level}}|${logger}|${message}|${exception:format=tostring}"
				archiveFileName="${logDir}/${shortdate}.{#}.log"
				archiveNumbering="Sequence"
				archiveAboveSize="5242880"
				maxArchiveFiles="10"
				concurrentWrites="true"
				keepFileOpen="false" />
	</targets>

	<rules>
		<!-- Trace/Debug/Info/Warn/Error/Fatal. Debug can be enabled at runtime from the Info dialog -->
		<logger name="*" minlevel="Info" writeTo="f" />
	</rules>
</nlog>
